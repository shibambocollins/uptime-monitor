{
  "name": "@uptime/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "deploy": "vite build && wrangler deploy",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@uptime/core": "*",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
