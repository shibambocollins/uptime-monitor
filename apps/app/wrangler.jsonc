{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uptime-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // Generated by Cloudflare's scaffolder. fetch() to a hostname on our own zone goes over the
  // public internet instead of straight to the origin. Keep it: the checker must see what an
  // outside visitor sees (verify exact semantics in the Phase 0 SSRF probe).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
}
