{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uptime-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // global_fetch_strictly_public: fetch() to a hostname on our own zone goes over the public
  // internet instead of straight to the origin, so the checker sees what an outside visitor
  // sees. With it, private and loopback targets get a Cloudflare 403/530 (Phase 0 probe).
  // ctx.exports (used by the tick to call CheckRunner) needs no flag: it is on by default
  // from compatibility date 2025-11-17 (workerd says so if the flag is added).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // The React build (vite.config.mts), served from the same origin as the API, so the session
  // cookie is first-party and there is no CORS (CLAUDE.md §3). Asset requests are free.
  "assets": {
    "directory": "./dist/client",
    // Unknown paths get index.html, so client-side routes work on reload.
    "not_found_handling": "single-page-application",
    // The API always reaches the Worker, even if a built file had a matching path.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      // Created 2026-10-21 (region WEUR). The id is not a secret: it only works with an
      // API token for this account. Local dev and tests use a local SQLite file instead.
      "database_id": "02a657df-ded5-4819-af0d-38cfe3ebd215",
      "migrations_dir": "migrations",
    },
  ],
  // The checker runs every minute (CLAUDE.md §5).
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    // Upper bound on checks claimed per tick. They run in groups of 10, each group in its
    // own invocation, because one invocation fits about 10 fetch() calls inside the 10 ms
    // CPU limit (Phase 0, docs/phase-0-checklist.md section 6). The tick deadline
    // (checker/tick.ts) releases any group that wouldn't finish in time.
    "MAX_CHECKS_PER_TICK": "40",
    // SPIKE (Phase 0 P6 only, remove after): wait this long between running the checks and
    // writing results, so a tick can be made to outlast the next cron firing.
    "SPIKE_SLOW_TICK_MS": "0",
  },
}
