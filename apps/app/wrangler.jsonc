{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "uptime-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // Generated by Cloudflare's scaffolder. fetch() to a hostname on our own zone goes over the
  // public internet instead of straight to the origin. Keep it: the checker must see what an
  // outside visitor sees (verify exact semantics in the Phase 0 SSRF probe).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // The React build (vite.config.mts), served from the same origin as the API, so the session
  // cookie is first-party and there is no CORS (CLAUDE.md §3). Asset requests are free.
  "assets": {
    "directory": "./dist/client",
    // Unknown paths get index.html, so client-side routes work on reload.
    "not_found_handling": "single-page-application",
    // The API always reaches the Worker, even if a built file had a matching path.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      // Created 2026-10-21 (region WEUR). The id is not a secret: it only works with an
      // API token for this account. Local dev and tests use a local SQLite file instead.
      "database_id": "02a657df-ded5-4819-af0d-38cfe3ebd215",
      "migrations_dir": "migrations",
    },
  ],
  // The checker runs every minute (CLAUDE.md §5).
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    // Upper bound on checks per tick. CPU decides it, not subrequests: each fetch() costs
    // about 0.25-0.45 ms of the 10 ms per invocation, and a 40-check cron tick measured
    // p99 29 ms (Phase 0, 2026-10-21). 10 keeps a tick inside the limit until checks are
    // spread over separate invocations (docs/phase-0-checklist.md, section 6).
    "MAX_CHECKS_PER_TICK": "10",
    // SPIKE (Phase 0 P6 only, remove after): wait this long between running the checks and
    // writing results, so a tick can be made to outlast the next cron firing.
    "SPIKE_SLOW_TICK_MS": "0",
  },
}
