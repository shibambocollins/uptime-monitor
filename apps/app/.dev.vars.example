# Copy to .dev.vars (gitignored) for `wrangler dev`. Values come from the *dev* GitHub
# OAuth App (callback http://localhost:5173/api/v1/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Overrides the production value in wrangler.jsonc: the origin the browser uses in dev
# (Vite on 5173, which proxies /api to wrangler dev on 8787).
APP_ORIGIN=http://localhost:5173
