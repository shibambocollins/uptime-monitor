{
  "description": "SSRF checks for monitor URLs (CLAUDE.md §8, rules 1-2). Any implementation (packages/core/src/url-validation.ts, or a future port) must return exactly `result` for each `input`. `addresses` covers the address check used on DNS answers (rule 3): `category` null means public.",
  "urls": [
    {
      "name": "accepts a plain https URL and adds the root path",
      "input": "https://example.com",
      "result": { "ok": true, "href": "https://example.com/" }
    },
    {
      "name": "normalises scheme, host case and default port, and drops the fragment",
      "input": "HTTP://Example.COM:80/path?q=1#frag",
      "result": { "ok": true, "href": "http://example.com/path?q=1" }
    },
    {
      "name": "ignores surrounding spaces",
      "input": "  https://example.com  ",
      "result": { "ok": true, "href": "https://example.com/" }
    },
    {
      "name": "accepts a fully qualified name with a trailing dot",
      "input": "https://example.com.",
      "result": { "ok": true, "href": "https://example.com./" }
    },
    {
      "name": "accepts a public IPv4 literal and a non-default port",
      "input": "https://8.8.8.8:8443/x",
      "result": { "ok": true, "href": "https://8.8.8.8:8443/x" }
    },
    {
      "name": "accepts a public IPv6 literal",
      "input": "https://[2606:4700:4700::1111]/",
      "result": { "ok": true, "href": "https://[2606:4700:4700::1111]/" }
    },
    {
      "name": "accepts an IPv4-mapped IPv6 literal of a public address",
      "input": "https://[::ffff:8.8.8.8]/",
      "result": { "ok": true, "href": "https://[::ffff:808:808]/" }
    },
    {
      "name": "accepts the address just below 172.16.0.0/12",
      "input": "http://172.15.255.255",
      "result": { "ok": true, "href": "http://172.15.255.255/" }
    },
    {
      "name": "accepts the address just above 172.16.0.0/12",
      "input": "http://172.32.0.0",
      "result": { "ok": true, "href": "http://172.32.0.0/" }
    },
    {
      "name": "accepts the address just above 100.64.0.0/10",
      "input": "http://100.128.0.0",
      "result": { "ok": true, "href": "http://100.128.0.0/" }
    },

    {
      "name": "rejects text that is not a URL",
      "input": "not a url",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },
    {
      "name": "rejects an empty string",
      "input": "",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },
    {
      "name": "rejects a relative URL",
      "input": "/relative",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },
    {
      "name": "rejects a URL without a host",
      "input": "https://",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },
    {
      "name": "rejects an IPv4 literal with an octet above 255",
      "input": "http://999.1.1.1",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },
    {
      "name": "rejects an IPv6 zone ID",
      "input": "http://[fe80::1%25eth0]",
      "result": { "ok": false, "reason": "INVALID_URL" }
    },

    {
      "name": "scheme: rejects ftp",
      "input": "ftp://example.com",
      "result": { "ok": false, "reason": "UNSUPPORTED_SCHEME" }
    },
    {
      "name": "scheme: rejects file",
      "input": "file:///etc/passwd",
      "result": { "ok": false, "reason": "UNSUPPORTED_SCHEME" }
    },
    {
      "name": "scheme: rejects javascript",
      "input": "javascript:alert(1)",
      "result": { "ok": false, "reason": "UNSUPPORTED_SCHEME" }
    },
    {
      "name": "scheme: rejects data",
      "input": "data:text/plain,hi",
      "result": { "ok": false, "reason": "UNSUPPORTED_SCHEME" }
    },
    {
      "name": "scheme: rejects ws",
      "input": "ws://example.com",
      "result": { "ok": false, "reason": "UNSUPPORTED_SCHEME" }
    },

    {
      "name": "credentials: rejects user and password",
      "input": "https://user:pass@example.com",
      "result": { "ok": false, "reason": "CREDENTIALS" }
    },
    {
      "name": "credentials: rejects a user name alone",
      "input": "https://user@example.com",
      "result": { "ok": false, "reason": "CREDENTIALS" }
    },

